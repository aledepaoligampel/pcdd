/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://cloudflareinsights.com; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# site.css and site.js are referenced with ?v=<content hash>; rename a font file if it changes.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
